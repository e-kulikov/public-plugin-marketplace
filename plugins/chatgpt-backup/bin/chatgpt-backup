#!/usr/bin/env python3
"""chatgpt-backup: back up ChatGPT conversations to a local folder. See ../README.md."""
import os
import sys

HERE = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, os.path.join(os.path.dirname(HERE), "lib"))

from chatgpt_backup.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
